<?xml version="1.0" encoding="UTF-8"?>
<!--
  LaunchAgent for the resident WhatsApp daemon: keeps the connection open so the local
  store stays fresh, and serves the loopback IPC that the MCP server proxies through.

  This is a TEMPLATE. launchd does not expand ~ or $HOME, so the placeholders below must
  become absolute paths. Generate your own copy — the generated file is gitignored,
  because it embeds your home directory:

    sed -e "s#__NODE__#$(command -v node)#" \
        -e "s#__REPO__#$PWD#" \
        -e "s#__HOME__#$HOME#" \
        com.whatsapp-mcp.daemon.plist.example \
        > ~/Library/LaunchAgents/com.whatsapp-mcp.daemon.plist
    launchctl load -w ~/Library/LaunchAgents/com.whatsapp-mcp.daemon.plist

  Stop (persists across reboots):
    launchctl unload -w ~/Library/LaunchAgents/com.whatsapp-mcp.daemon.plist
  Logs:
    tail -f ~/Library/Logs/whatsapp-mcp-daemon.log
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.whatsapp-mcp.daemon</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__REPO__/src/daemon.mjs</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <key>RunAtLoad</key>
  <true/>

  <!-- Restart if it exits for any reason (crash, network flap, etc.) -->
  <key>KeepAlive</key>
  <true/>

  <!-- Don't restart-storm: wait 10s between respawns -->
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/whatsapp-mcp-daemon.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/whatsapp-mcp-daemon.log</string>
</dict>
</plist>
